{
  "name": "solfege-scroller",
  "private": true,
  "version": "0.1.0",
  "description": "High-performance client-only web tool for sight-reading and solfège practice with continuous procedural notation scrolling",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lauseta/solfege-scroller.git"
  },
  "keywords": [
    "solfege",
    "sight-reading",
    "music-notation",
    "vexflow",
    "canvas",
    "web-audio"
  ],
  "author": "lauseta",
  "license": "MIT",
  "dependencies": {
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
